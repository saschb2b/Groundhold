# Settings for deploy/selfhost/compose.yaml: save as .env beside it
# (server/README.md, On a server, with a domain). Only DOMAIN is needed.

# The domain players type into Groundhold's Join panel. Its DNS record points
# at this computer, and ports 80 and 443 are open to the internet: Caddy gets
# its certificate from Let's Encrypt.
DOMAIN=

# The server's name and its line of welcome, as the game and /health show
# them (at most 64 and 160 bytes, printable).
# SERVER_NAME=Groundhold
# SERVER_MOTD=Hold the road together

# Players at once.
# PLAYER_CAP=64

# The image's tag: a release (1.0.0), its latest patch (1.0), or latest.
# VERSION=latest
