    </screenshot>
    <screenshot>
      <caption>The Builders: each with three towers and their branches</caption>
      <image>https://saschb2b.github.io/Groundhold/media/builders.webp</image>
    </screenshot>
    <screenshot>
      <caption>A party of three on a server of your own</caption>
