{
  "version": 1,
  "background": "#2a3324",
  "model_background": "#4a5a3a",
  "model_material": "res://materials/painted.tres",
  "palettes": {
    "hollow": "palettes/hollow.gpl"
  },
  "ignore": [
    "docs/**",
    "web/**"
  ],
  "rules": [
    {
      "match": "models/**/*.glb",
      "model": {
        "origin": "bottom",
        "max_tris": 1200,
        "palette": "hollow",
        "palette_tolerance": 26,
        "max_materials": 3
      }
    },
    {
      "match": "models/vegetation/*.glb",
      "model": {
        "max_tris": 2600,
        "origin": "bottom-center",
        "max_size": [
          1.8,
          2.8,
          1.8
        ],
        "colors": {
          "bark": "#5b3a29",
          "leaf": "#3f7a2e",
          "leaf_light": "#7fb444",
          "needle": "#1d4528",
          "needle_light": "#3f8a3a",
          "blade": "#6a9a3c",
          "blade_light": "#8fb84e",
          "stone": "#8a8580",
          "stone_dark": "#6c6863",
          "skin": "#d9772b",
          "stem": "#5a6b2e",
          "cap": "#b8432f",
          "stalk": "#e6dcc3",
          "wood": "#a0784a",
          "petal": "#e8c04a",
          "center": "#7a4a20"
        },
        "max_materials": 4
      }
    },
    {
      "match": "models/towers/*.glb",
      "model": {
        "max_tris": 1600,
        "max_size": [
          0.98,
          2.4,
          0.98
        ]
      }
    },
    {
      "match": "models/towers/pennant.glb",
      "model": {
        "origin": null
      },
      "note": "pivot is where the cloth meets the flagpole"
    },
    {
      "match": "models/creeps/*.glb",
      "model": {
        "max_tris": 4000,
        "origin": "bottom-center",
        "max_size": [
          1.1,
          1.3,
          1.1
        ],
        "max_materials": 4,
        "animations": [
          "walk"
        ]
      }
    },
    {
      "match": "models/projectiles/*.glb",
      "model": {
        "max_tris": 120,
        "origin": null,
        "max_size": [
          0.4,
          0.4,
          0.5
        ]
      }
    },
    {
      "match": "models/props/*.glb",
      "model": {
        "max_tris": 1000,
        "origin": "bottom-center"
      }
    },
    {
      "match": "models/props/lantern_post.glb",
      "model": {
        "origin": "bottom"
      },
      "note": "pivot is the post, the lantern hangs to the side"
    },
    {
      "match": "sfx/*.wav",
      "audio": {
        "max_peak_db": -1.0,
        "max_leading_silence_ms": 20,
        "sample_rates": [
          44100
        ],
        "channels": 1,
        "max_duration_s": 1.6
      }
    },
    {
      "match": "models/ui/*.glb",
      "model": {
        "max_tris": 1500,
        "origin": "bottom-center"
      },
      "note": "drawn only as icons, so they may carry more shape than world props"
    },
    {
      "match": "ui/icons/*.png",
      "image": {
        "size": [
          64,
          64
        ]
      }
    },
    {
      "match": [
        "ui/icons/arrow_tower.png",
        "ui/icons/cannon_tower.png",
        "ui/icons/frost_tower.png",
        "ui/icons/upgrade.png",
        "ui/icons/sell.png",
        "ui/icons/next_wave.png"
      ],
      "image": {
        "size": [
          108,
          108
        ]
      },
      "note": "command icons: twice the 54 px socket, drawn at half size"
    },
    {
      "match": [
        "ui/icons/res_gold.png",
        "ui/icons/res_lives.png"
      ],
      "image": {
        "size": [
          128,
          128
        ]
      },
      "note": "resource icons: cropped and drawn at about 30 px, sharp at 2x"
    },
    {
      "match": "ui/console/*.png",
      "image": {
        "max_size": [
          1600,
          512
        ]
      },
      "note": "painted at twice the layout size (art_src/ui/console.json scale 2)"
    },
    {
      "match": "textures/*.png",
      "image": {
        "size": [
          256,
          256
        ]
      }
    },
    {
      "match": "models/creeps/hollowtide_crest.glb",
      "model": {
        "max_tris": 7000,
        "max_size": [
          1.3,
          1.6,
          1.3
        ]
      }
    },
    {
      "match": "textures/foliage_*.png",
      "image": {
        "size": [
          256,
          256
        ]
      }
    },
    {
      "match": "art_src/ui/renders/*.png",
      "image": {
        "size": [
          216,
          216
        ]
      },
      "note": "raw model renders (godot-agent asset icon, no frame) that art_src/ui/icons.py frames"
    }
  ]
}
