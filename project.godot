; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Groundhold"
config/description="A tower defense: Builders from every shore hold one another's ground against the Tide."
config/version="0.8.0"
run/main_scene="res://scenes/hub.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://ui/icons/arrow_tower.png"

[autoload]

Game="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"
Session="*res://scripts/session/session.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.165, 0.2, 0.141, 1)
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048

[godot_agent]

play_describe="res://tools/play/describe.gd"
play_renderer="gl_compatibility"
play_user="res://tools/play/user"
