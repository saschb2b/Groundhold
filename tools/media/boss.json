{
  "scene": "res://scenes/main.tscn",
  "name": "boss",
  "seed": 3,
  "ticks_per_frame": 2,
  "timeout_frames": 2400,
  "steps": [
    {
      "set": "Game.gold",
      "value": 3000
    },
    {
      "eval": "resource('res://tests/bot.gd').new()",
      "as": "bot"
    },
    {
      "repeat": 20,
      "steps": [
        {
          "eval": "bot.step(scene)"
        },
        {
          "wait": 2
        }
      ],
      "until": "bot.done == 20 and scene.settled()"
    },
    {
      "set": "Game.wave",
      "value": 7
    },
    {
      "set": "Game.countdown",
      "value": 0.1
    },
    {
      "wait_until": "Game.wave == 8 and Game.spawns_left() == 0",
      "timeout": 900
    },
    {
      "wait": 90
    },
    {
      "eval": "scene.camera.look_from(group('creeps')[count('creeps') - 1].global_position, 8.0)"
    },
    {
      "eval": "node('BuildController').select_creep(group('creeps')[count('creeps') - 1])"
    },
    {
      "wait": 6
    },
    {
      "capture": "boss"
    }
  ]
}
