{
  "name": "art_causeway_props",
  "description": "The Causeway at low water, the hub's backdrop (design 5.1, world.md), has its props: a road segment exactly 2 units long along +Z, so segments chain end to end, raised above the flats and no wider than a tile and a half each side of its centre; a tide pole, a waymark cairn and a clump of wrack, each one mesh standing on the flats with its footprint centred, and none lit: the Causeway belongs to no land, so it carries no lanterns.",
  "seed": 1,
  "timeout_frames": 120,
  "steps": [
    {"wait": 3},
    {"set": "node('NameField').text", "value": "Sascha"},
    {"key": "Enter"},
    {"eval": "resource('res://models/causeway/road.glb').instantiate()", "as": "road"},
    {"eval": "road.find_children('*', 'MeshInstance3D', true, false)", "as": "road_meshes"},
    {"assert": "road_meshes.size() == 1", "msg": "the road segment is one mesh"},
    {"eval": "road_meshes[0].get_aabb()", "as": "road_box"},
    {"assert": "abs(road_box.size.z - 2.0) < 0.001 and abs(road_box.get_center().z) < 0.001", "msg": "2 units long, centred: segments chain every 2 units along +Z"},
    {"assert": "abs(road_box.position.y) < 0.01 and road_box.size.y > 0.3 and road_box.size.y < 0.5", "msg": "raised above the flats it stands on"},
    {"assert": "road_box.size.x > 1.2 and road_box.size.x < 1.7 and abs(road_box.get_center().x) < 0.01", "msg": "a road a little over a tile wide, centred"},
    {"assert": "road_meshes[0].mesh.get_surface_count() == 1", "msg": "painted stone only, nothing lit"},
    {"eval": "road.free()"},
    {"eval": "null", "as": "road"},
    {"eval": "[]", "as": "road_meshes"},

    {"eval": "resource('res://models/causeway/pole.glb').instantiate()", "as": "pole"},
    {"eval": "pole.find_children('*', 'MeshInstance3D', true, false)[0].get_aabb()", "as": "pole_box"},
    {"assert": "abs(pole_box.position.y) < 0.01 and pole_box.size.y > 1.2 and pole_box.size.y < 1.6", "msg": "the tide pole stands on the flats, taller than a person"},
    {"assert": "pole.find_children('*', 'MeshInstance3D', true, false)[0].mesh.get_surface_count() == 1", "msg": "the pole is not lit"},
    {"eval": "pole.free()"},
    {"eval": "null", "as": "pole"},
    {"eval": "resource('res://models/causeway/cairn.glb').instantiate()", "as": "cairn"},
    {"eval": "cairn.find_children('*', 'MeshInstance3D', true, false)[0].get_aabb()", "as": "cairn_box"},
    {"assert": "abs(cairn_box.position.y) < 0.01 and cairn_box.size.y > 0.3 and cairn_box.size.y < 0.6", "msg": "the cairn stands knee-high on the flats"},
    {"assert": "abs(cairn_box.get_center().x) < 0.06 and abs(cairn_box.get_center().z) < 0.06", "msg": "its footprint centred"},
    {"eval": "cairn.free()"},
    {"eval": "null", "as": "cairn"},
    {"eval": "resource('res://models/causeway/wrack.glb').instantiate()", "as": "wrack"},
    {"eval": "wrack.find_children('*', 'MeshInstance3D', true, false)[0].get_aabb()", "as": "wrack_box"},
    {"assert": "abs(wrack_box.position.y) < 0.01 and wrack_box.size.y < 0.1", "msg": "the wrack lies flat on the flats"},
    {"eval": "wrack.free()"},
    {"eval": "null", "as": "wrack"}
  ]
}
