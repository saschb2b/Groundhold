{
  "name": "art_console_screen_pieces",
  "description": "The console pieces the screens outside a match need (art_src/ui/console.py, design 3.7 and 5.2-5.8) are painted and placed by layout.json: a large panel whose stone tiles seamlessly both ways (tile-fit, its shadow outside the control), the jewel to crown it, a card frame and its lit state, an arched portrait plate with an open window and its backdrop, a text field and its focus, a progress bar's trough and fill, a divider; every StyleBox loads over its texture. Rendered, it builds a loading screen from them as Godot draws them, with the Builders turning in the plates.",
  "seed": 1,
  "timeout_frames": 900,
  "steps": [
    {"wait": 3},
    {"set": "node('NameField').text", "value": "Sascha"},
    {"key": "Enter"},
    {"eval": "resource('res://ui/console/layout.json').data", "as": "layout"},
    {"eval": "float(layout['scale'])", "as": "k"},
    {"assert": "layout.has('panel')", "msg": "layout.json places the screens' panel"},
    {"assert": "layout.has('panel_jewel')", "msg": "layout.json places the screens' panel_jewel"},
    {"assert": "layout.has('card_frame')", "msg": "layout.json places the screens' card_frame"},
    {"assert": "layout.has('portrait_plate')", "msg": "layout.json places the screens' portrait_plate"},
    {"assert": "layout.has('field')", "msg": "layout.json places the screens' field"},
    {"assert": "layout.has('bar')", "msg": "layout.json places the screens' bar"},
    {"assert": "layout.has('divider')", "msg": "layout.json places the screens' divider"},
    {"assert": "resource('res://ui/console/panel.tres').get_class() == 'StyleBoxTexture' and resource('res://ui/console/panel.tres').texture != null", "msg": "panel.tres is a nine-slice over its painted texture"},
    {"assert": "resource('res://ui/console/card_frame.tres').get_class() == 'StyleBoxTexture' and resource('res://ui/console/card_frame.tres').texture != null", "msg": "card_frame.tres is a nine-slice over its painted texture"},
    {"assert": "resource('res://ui/console/card_frame_lit.tres').get_class() == 'StyleBoxTexture' and resource('res://ui/console/card_frame_lit.tres').texture != null", "msg": "card_frame_lit.tres is a nine-slice over its painted texture"},
    {"assert": "resource('res://ui/console/field.tres').get_class() == 'StyleBoxTexture' and resource('res://ui/console/field.tres').texture != null", "msg": "field.tres is a nine-slice over its painted texture"},
    {"assert": "resource('res://ui/console/field_focus.tres').get_class() == 'StyleBoxTexture' and resource('res://ui/console/field_focus.tres').texture != null", "msg": "field_focus.tres is a nine-slice over its painted texture"},
    {"assert": "resource('res://ui/console/bar_trough.tres').get_class() == 'StyleBoxTexture' and resource('res://ui/console/bar_trough.tres').texture != null", "msg": "bar_trough.tres is a nine-slice over its painted texture"},
    {"assert": "resource('res://ui/console/bar_fill.tres').get_class() == 'StyleBoxTexture' and resource('res://ui/console/bar_fill.tres').texture != null", "msg": "bar_fill.tres is a nine-slice over its painted texture"},
    {"assert": "resource('res://ui/console/divider.tres').get_class() == 'StyleBoxTexture' and resource('res://ui/console/divider.tres').texture != null", "msg": "divider.tres is a nine-slice over its painted texture"},
    {"eval": "resource('res://ui/console/panel.tres')", "as": "panel_box"},
    {"assert": "panel_box.axis_stretch_horizontal == 2 and panel_box.axis_stretch_vertical == 2", "msg": "the panel's middle tiles whole tiles (tile-fit), so its stone is never stretched"},
    {"assert": "panel_box.expand_margin_left == layout['panel']['expand'] * k", "msg": "the panel's shadow is drawn outside the control, whose rect is the bronze edge"},
    {"assert": "panel_box.texture.get_size() == Vector2(2 * layout['panel']['margin'] + layout['panel']['tile'][0], 2 * layout['panel']['margin'] + layout['panel']['tile'][1]) * k", "msg": "panel.png is its margins round one tile, at the layout's scale"},
    {"eval": "panel_box.texture.get_image()", "as": "stone"},
    {"eval": "int(layout['panel']['margin'] * k)", "as": "m"},
    {"eval": "int(layout['panel']['tile'][0] * k)", "as": "tx"},
    {"eval": "int(layout['panel']['tile'][1] * k)", "as": "ty"},
    {"assert": "stone.get_pixel(m, m + 40) == stone.get_pixel(m + tx, m + 40) and stone.get_pixel(m, m + 170) == stone.get_pixel(m + tx, m + 170)", "msg": "the stone repeats seamlessly across: a tile's first column continues its last"},
    {"assert": "stone.get_pixel(m + 150, m) == stone.get_pixel(m + 150, m + ty) and stone.get_pixel(m + 400, m) == stone.get_pixel(m + 400, m + ty)", "msg": "and down"},
    {"assert": "stone.get_pixel(m, m + 40) != stone.get_pixel(m + 37, m + 40) or stone.get_pixel(m, m + 40) != stone.get_pixel(m + 91, m + 113)", "msg": "the stone has grain (the seam test above is not passing on a flat colour)"},
    {"assert": "resource('res://ui/console/panel_jewel.png').get_size() == Vector2(layout['panel_jewel']['size'][0], layout['panel_jewel']['size'][1]) * k", "msg": "the jewel is the size layout.json gives it"},
    {"assert": "resource('res://ui/console/portrait_plate.png').get_size() == Vector2(layout['portrait_plate']['size'][0], layout['portrait_plate']['size'][1]) * k", "msg": "the portrait plate is the size layout.json gives it"},
    {"assert": "resource('res://ui/console/portrait_plate_bg.png').get_size() == Vector2(layout['portrait_plate']['backdrop'][2], layout['portrait_plate']['backdrop'][3]) * k", "msg": "its backdrop fills the backdrop rect"},
    {"eval": "resource('res://ui/console/portrait_plate.png').get_image()", "as": "plate"},
    {"eval": "layout['portrait_plate']['window']", "as": "win"},
    {"assert": "plate.get_pixel(int((win[0] + win[2] / 2) * k), int((win[1] + win[3] * 0.6) * k)).a == 0.0", "msg": "the plate's window is open, so the portrait under it shows"},
    {"assert": "plate.get_pixel(int((win[0] - 6) * k), int((win[1] + win[3] * 0.6) * k)).a == 1.0", "msg": "and its moulding is solid"},
