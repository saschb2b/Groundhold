{
  "name": "bronze_hand_ignores_2",
  "description": "The Bellfounder's perk, Bronze Hand (design 3.4): every hit of her towers ignores 2 armour, forked ones and pulses too. Her Clapper Tower's 30 does 28 to a Thornback (armour 4) and 26 to the Bristlesow (armour 6); a Great Clapper's 72 does 68 to the Bristlesow. The Lamplighter's arrow beside her keeps the plain rule: 8 does 4 to the Thornback. Classic has no perks: her towers pierce nothing.",
  "scene": "res://tests/sim/sim_harness.tscn",
  "seed": 1,
  "timeout_frames": 60,
  "steps": [
    {"eval": "scene.start({'mode': 'high_water', 'seats': 2, 'builders': ['bellfounder', 'lamplighter']})"},
    {"eval": "[scene.debug(1, 1, 2000), scene.debug(1, 2, 2000)]"},
    {"eval": "[scene.cmd(1, 'BUILD', 0, 5, 3), scene.cmd(2, 'BUILD', 0, 8, 3), scene.cmd(1, 'BUILD', 1, 6, 3)]"},
    {"eval": "scene.run_ticks(6)"},
    {"eval": "[scene.tower_at(5, 3), scene.tower_at(8, 3), scene.tower_at(6, 3)]", "as": "t"},
    {"assert": "[t[0].pierce_c, t[1].pierce_c, t[2].pierce_c] == [200, 0, 200]", "msg": "her Clapper Tower and Toll Tower pierce 2; the Lamplighter's arrow nothing"},
    {"eval": "scene.spawn('thornback', 5000000)", "as": "c"},
    {"eval": "scene.hold(c)"},
    {"eval": "scene.run_ticks(100)"},
    {"assert": "scene.hit_values('clapper_tower', 'thornback') == [[2800, 3000, 200]]", "msg": "her Clapper Tower does 28 to the Thornback, not 26"},
    {"assert": "scene.hit_values('toll_tower', 'thornback') == [[600, 800, 200]]", "msg": "her pulse 6 of 8"},
    {"assert": "scene.hit_values('arrow', 'thornback') == [[400, 800, 400]]", "msg": "the Lamplighter's arrow keeps the plain rule: 4 of 8"},
    {"eval": "scene.debug(5, c, 45000000)"},
    {"eval": "scene.spawn('bristlesow', 5000000)", "as": "boar"},
    {"eval": "scene.hold(boar)"},
    {"eval": "scene.run_ticks(100)"},
    {"assert": "scene.hit_values('clapper_tower', 'bristlesow') == [[2600, 3000, 400]]", "msg": "26 to the Bristlesow, its 6 armour less 2"},
    {"eval": "scene.cmd(1, 'FORK', t[0].id, 0)"},
    {"eval": "scene.run_ticks(120)"},
    {"assert": "t[0].pierce_c == 200 and scene.hit_values('clapper_tower', 'bristlesow').has([6800, 7200, 400])", "msg": "a Great Clapper keeps the perk: 68 of 72"},
    {"eval": "scene.start({'mode': 'classic', 'seats': 1, 'builders': ['bellfounder']})"},
    {"eval": "scene.debug(1, 1, 2000)"},
    {"eval": "scene.cmd(1, 'BUILD', 0, 5, 3)"},
    {"eval": "scene.run_ticks(6)"},
    {"assert": "scene.tower_at(5, 3).pierce_c == 0", "msg": "classic has no perks: no Bronze Hand"}
  ]
}
