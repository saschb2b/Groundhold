{
  "scene": "res://scenes/main.tscn",
  "name": "view_m6_muzzles",
  "description": "Each M6 form's muzzle sits where its model's shot or ring leaves from (contract-m6.md §5, design 3.7), measured on the models track B built (art_src/models/towers/m6_kits.py's recipes): a Clapper Tower's and a Toll Tower's between their bell's lip and its crown (the toll's ring bursts there, the Sky Toll's bell hung high under its arch), a Chime Post's among its chimes, a Clay Hive's at its middle rows of pipe mouths at the front, an Apiary's at its top ring of bee holes inside the house (so a bee leaves through the wall toward its creep), a Hive Hum's within its straw hive; none above its model. Captures show a red bead at every muzzle.",
  "seed": 1,
  "timeout_frames": 900,
  "watch": {
    "hash": "scene.state_hash_hex()"
  },
  "steps": [
    {
      "eval": "scene.begin('high_water', [{'team': 0, 'builder': 'bellfounder'}, {'team': 0, 'builder': 'beekeeper'}], 1, resource('res://scripts/net/local_sequencer.gd').new(2, 1), 1)"
    },
    {
      "wait": 2
    },
    {
      "set": "Game.countdown",
      "value": 90
    },
    {
      "set": "Game.gold",
      "value": 3000
    },
    {
      "eval": "Game.debug(1, 2, 3000)"
    },
    {
      "eval": "scene.source.submit(1, 0, 6, 3)"
    },
    {
      "eval": "scene.source.submit(1, 0, 8, 3)"
    },
    {
      "eval": "scene.source.submit(1, 0, 8, 4)"
    },
    {
      "eval": "scene.source.submit(1, 1, 6, 4)"
    },
    {
      "eval": "scene.source.submit(1, 1, 6, 5)"
    },
    {
      "eval": "scene.source.submit(1, 1, 8, 5)"
    },
    {
      "eval": "scene.source.submit(1, 2, 9, 5)"
    },
    {
      "eval": "scene.source.submit(1, 2, 10, 5)"
    },
    {
      "eval": "scene.source.submit(1, 2, 10, 4)"
    },
    {
      "eval": "scene.source.submit_as(2, 1, 0, 10, 7)"
    },
    {
      "eval": "scene.source.submit_as(2, 1, 0, 12, 7)"
    },
    {
      "eval": "scene.source.submit_as(2, 1, 0, 14, 7)"
    },
    {
      "eval": "scene.source.submit_as(2, 1, 1, 16, 7)"
    },
    {
      "eval": "scene.source.submit_as(2, 1, 1, 14, 8)"
    },
    {
      "eval": "scene.source.submit_as(2, 1, 1, 16, 8)"
    },
    {
      "eval": "scene.source.submit_as(2, 1, 2, 13, 8)"
    },
    {
      "eval": "scene.source.submit_as(2, 1, 2, 12, 8)"
    },
    {
      "eval": "scene.source.submit_as(2, 1, 2, 10, 8)"
    },
    {
      "wait_until": "count('towers') == 18",
      "timeout": 30
    },
    {
      "eval": "scene.source.submit(2, scene.tower_at(Vector2i(8, 3)).id, 0)"
    },
    {
      "eval": "scene.source.submit(2, scene.tower_at(Vector2i(8, 4)).id, 1)"
    },
    {
      "eval": "scene.source.submit(2, scene.tower_at(Vector2i(6, 5)).id, 0)"
    },
    {
      "eval": "scene.source.submit(2, scene.tower_at(Vector2i(8, 5)).id, 1)"
    },
    {
      "eval": "scene.source.submit(2, scene.tower_at(Vector2i(10, 5)).id, 0)"
    },
    {
      "eval": "scene.source.submit(2, scene.tower_at(Vector2i(10, 4)).id, 1)"
    },
    {
      "eval": "scene.source.submit_as(2, 2, scene.tower_at(Vector2i(12, 7)).id, 0)"
    },
    {
      "eval": "scene.source.submit_as(2, 2, scene.tower_at(Vector2i(14, 7)).id, 1)"
    },
    {
      "eval": "scene.source.submit_as(2, 2, scene.tower_at(Vector2i(14, 8)).id, 0)"
    },
    {
      "eval": "scene.source.submit_as(2, 2, scene.tower_at(Vector2i(16, 8)).id, 1)"
    },
    {
      "eval": "scene.source.submit_as(2, 2, scene.tower_at(Vector2i(12, 8)).id, 0)"
    },
    {
      "eval": "scene.source.submit_as(2, 2, scene.tower_at(Vector2i(10, 8)).id, 1)"
    },
    {
      "wait_until": "scene.sim.seat(1).forks + scene.sim.seat(2).forks == 12",
      "timeout": 30
    },
    {
      "wait": 2
    },
    {
      "eval": "resource('res://tests/views/m6_views.gd').muzzle_problems()",
      "as": "off"
    },
    {
      "assert": "off == []",
      "msg": "every M6 muzzle sits on the part it belongs to on its model: a bell, the chimes, the pipe mouths, the bee holes, the straw hive"
    },
    {
      "assert": "absf(scene.tower_at(Vector2i(16, 7)).muzzle_point().y - scene.tower_at(Vector2i(16, 7)).global_position.y - 0.88) < 0.001",
      "msg": "the Apiary's bees leave from its top ring of holes"
    },
    {
      "eval": "resource('res://tests/views/m6_views.gd').mark_muzzles(scene)",
      "as": "beads"
    },
    {
      "assert": "beads == 18",
      "msg": "a bead at every muzzle, to look at"
    },
    {
      "eval": "scene.camera.look_from(Vector3(9.0, 0, 4.4), 6.5)"
    },
    {
      "wait": 30
    },
    {
      "capture": "m6_muzzles_bellfounder"
    },
    {
      "eval": "scene.camera.look_from(Vector3(13.4, 0, 7.6), 6.5)"
    },
    {
      "wait": 30
    },
    {
      "capture": "m6_muzzles_beekeeper"
    }
  ]
}
