{
  "name": "art_builder_portraits",
  "description": "The Lamplighter's and the Lookout's art is painted at the paths the M2/M3 contract names (Game.BUILDERS' portrait and glyph), not the placeholder: each portrait is one figure mesh standing on the ground with its footprint centred, a chibi figure's height (taller than a creep, under a tower; Tamsin Wick's lamp pole rises over her head), the Lamplighter's lantern a second, glowing surface; each glyph is a 128 px portrait. Rendered, it captures both in hub-arch-sized portraits turning as the hub shows them.",
  "seed": 1,
  "timeout_frames": 600,
  "steps": [
    {"wait": 3},
    {"set": "node('NameField').text", "value": "Sascha"},
    {"key": "Enter"},
    {"assert": "Game.has_art(Game.BUILDERS['lamplighter']['portrait'])", "msg": "the Lamplighter's portrait model is painted"},
    {"assert": "Game.has_art(Game.BUILDERS['lookout']['portrait'])", "msg": "the Lookout's portrait model is painted"},
    {"assert": "Game.has_art(Game.BUILDERS['lamplighter']['glyph'])", "msg": "the Lamplighter's glyph is painted"},
    {"assert": "Game.has_art(Game.BUILDERS['lookout']['glyph'])", "msg": "the Lookout's glyph is painted"},
    {"assert": "Game.icon(Game.BUILDERS['lamplighter']['glyph']).get_size() == Vector2(128, 128)", "msg": "a 128 px portrait, drawn at up to 64"},
    {"assert": "Game.icon(Game.BUILDERS['lookout']['glyph']).get_size() == Vector2(128, 128)", "msg": "a 128 px portrait, drawn at up to 64"},

    {"eval": "resource(Game.BUILDERS['lamplighter']['portrait']).instantiate()", "as": "lamp"},
    {"eval": "lamp.find_children('*', 'MeshInstance3D', true, false)", "as": "lamp_meshes"},
    {"assert": "lamp_meshes.size() == 1", "msg": "the Lamplighter is one mesh, so the portrait measures and turns one thing"},
    {"eval": "lamp_meshes[0].get_aabb()", "as": "lamp_box"},
    {"assert": "abs(lamp_box.position.y) < 0.02", "msg": "she stands on the ground"},
    {"assert": "lamp_box.size.y > 1.0 and lamp_box.size.y < 1.5", "msg": "a figure's height, the crook included"},
    {"assert": "abs(lamp_box.get_center().x) < 0.12 and abs(lamp_box.get_center().z) < 0.12", "msg": "footprint centred on the pivot"},
    {"assert": "lamp_meshes[0].mesh.get_surface_count() == 2", "msg": "painted, plus the lantern's glow"},

    {"eval": "resource(Game.BUILDERS['lookout']['portrait']).instantiate()", "as": "look"},
    {"eval": "look.find_children('*', 'MeshInstance3D', true, false)", "as": "look_meshes"},
    {"assert": "look_meshes.size() == 1", "msg": "the Lookout is one mesh"},
    {"eval": "look_meshes[0].get_aabb()", "as": "look_box"},
    {"assert": "abs(look_box.position.y) < 0.02", "msg": "she stands on the ground"},
    {"assert": "look_box.size.y > 0.8 and look_box.size.y < 1.5", "msg": "a chibi figure's height, the hood's tufts and plume included"},
    {"assert": "abs(look_box.get_center().x) < 0.12 and abs(look_box.get_center().z) < 0.12", "msg": "footprint centred on the pivot"},
    {"assert": "look_meshes[0].mesh.get_surface_count() >= 1", "msg": "the toon figure; the spyglass is a swatch, not a light"},
    {"assert": "lamp_box.size.y > look_box.size.y", "msg": "Tamsin Wick's lamp pole stands over both heads"},
    {"eval": "lamp.free()"},
    {"eval": "look.free()"},
    {"eval": "null", "as": "lamp"},
    {"eval": "null", "as": "look"},
    {"eval": "[]", "as": "lamp_meshes"},
    {"eval": "[]", "as": "look_meshes"},

    {"eval": "ClassDB.instantiate('CanvasLayer')", "as": "layer"},
    {"set": "layer.layer", "value": 100},
    {"eval": "scene.add_child(layer)"},
    {"eval": "ClassDB.instantiate('ColorRect')", "as": "shade"},
    {"set": "shade.color", "value_expr": "Color(0.08, 0.07, 0.06)"},
    {"eval": "shade.set_size(Vector2(1280, 720))"},
    {"eval": "layer.add_child(shade)"},
    {"eval": "ClassDB.instantiate('TextureRect')", "as": "back1"},
    {"eval": "ClassDB.instantiate('TextureRect')", "as": "back2"},
    {"set": "back1.texture", "value_expr": "resource('res://ui/console/portrait_bg.png')"},
    {"set": "back2.texture", "value_expr": "resource('res://ui/console/portrait_bg.png')"},
    {"set": "back1.expand_mode", "value": 1},
    {"set": "back2.expand_mode", "value": 1},
    {"eval": "layer.add_child(back1)"},
    {"eval": "layer.add_child(back2)"},
    {"eval": "back1.set_position(Vector2(472, 296))"},
    {"eval": "back1.set_size(Vector2(130, 134))"},
    {"eval": "back2.set_position(Vector2(678, 296))"},
    {"eval": "back2.set_size(Vector2(130, 134))"},
    {"eval": "resource('res://scripts/portrait.gd').new()", "as": "arch1"},
    {"eval": "resource('res://scripts/portrait.gd').new()", "as": "arch2"},
    {"eval": "layer.add_child(arch1)"},
    {"eval": "layer.add_child(arch2)"},
    {"eval": "arch1.set_position(Vector2(475, 299))"},
    {"eval": "arch1.set_size(Vector2(124, 128))"},
    {"eval": "arch2.set_position(Vector2(681, 299))"},
    {"eval": "arch2.set_size(Vector2(124, 128))"},
    {"eval": "arch1.show_model(Game.BUILDERS['lamplighter']['portrait'])"},
    {"eval": "arch2.show_model(Game.BUILDERS['lookout']['portrait'])"},
    {"wait": 3},
    {"capture": "hub_arch_lamplighter_and_lookout"},
    {"wait": 90},
    {"capture": "hub_arch_lamplighter_and_lookout_turning"}
  ]
}
