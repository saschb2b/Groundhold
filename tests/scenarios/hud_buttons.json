{
  "name": "hud_buttons",
  "seed": 1,
  "watch": {
    "hash": "scene.state_hash_hex()"
  },
  "steps": [
    {
      "wait": 2
    },
    {
      "set": "Game.gold",
      "value": 300
    },
    {
      "click": "node('BuildCannon')"
    },
    {
      "assert": "node('BuildController').mode == 'cannon'",
      "msg": "the command card button enters build mode"
    },
    {
      "assert": "screen_has('Cannon Tower')",
      "msg": "and the info panel describes the tower"
    },
    {
      "click": "scene.cell_center(Vector2i(6, 4))"
    },
    {
      "wait_until": "scene.settled()",
      "timeout": 12
    },
    {
      "assert": "scene.tower_at(Vector2i(6, 4)) != null",
      "msg": "a click on the map places it"
    },
    {
      "click": "scene.cell_center(Vector2i(6, 4))"
    },
    {
      "assert": "not node('Upgrade').disabled",
      "msg": "upgrade is offered for the selected tower"
    },
    {
      "click": "node('Ready')"
    },
    {
      "wait_until": "Game.state == 1",
      "timeout": 10
    },
    {
      "assert": "Game.wave == 1 and Game.state == 1",
      "msg": "Ready (the war horn) starts wave 1"
    },
    {
      "assert": "node('Ready').disabled and node('Ready').get_meta('state') == 'idle'",
      "msg": "and is idle while the wave runs"
    },
    {
      "click": "node('Sell')"
    },
    {
      "wait_until": "count('towers') == 0",
      "timeout": 12
    },
    {
      "assert": "count('towers') == 0",
      "msg": "Sell removes the selected tower"
    }
  ]
}
