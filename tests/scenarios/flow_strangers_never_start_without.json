{
  "name": "flow_strangers_never_start_without",
  "description": "A match of strangers the queue found starts by its barrier's timers alone (design 6.6): past 30 s of loading with a stranger still loading, the leader's loading screen offers no Start without, as the server refuses it for strangers, and a start sent anyway changes nothing. A party's own match still offers it (flow_loading_start_without).",
  "seed": 1,
  "timeout_frames": 6000,
  "steps": [
    {"wait": 3},
    {"set": "node('NameField').text", "value": "Sascha"},
    {"key": "Enter"},
    {"eval": "Session.add_child(resource('res://tests/net/loopback_hub.gd').new())"},
    {"eval": "Session.get_node('LoopbackHub').start({})"},
    {"eval": "Session.create_party()"},
    {"wait_until": "Session.party_code() == 'K7Q4M'", "timeout": 120},
    {"eval": "Session.set_open(true)"},
    {"wait_until": "node('HubPanel').primary_text() == 'Find players'", "timeout": 60},
    {"click": "node('Primary')"},
    {"wait_until": "Session.state_name() == 'QUEUED'", "timeout": 60},
    {"eval": "Session.get_node('LoopbackHub').stranger('Edda', 'lookout', 'lamplighter')"},
    {"eval": "Session.get_node('LoopbackHub').stranger('Ottilie', 'lamplighter', 'lookout')"},
    {"eval": "Session.get_node('LoopbackHub').stranger('Wen', 'lookout', 'lamplighter')"},
    {"wait_until": "Session.state_name() == 'MATCH_FOUND' and Session.get_node_or_null('MatchFound') != null", "timeout": 60},
    {"eval": "Session.accept_match()"},
    {"wait_until": "Session.state_name() == 'LOADING'", "timeout": 300},
    {"assert": "Session.strangers_match", "msg": "the session knows the match is one of strangers"},
    {"eval": "Session.get_node('LoopbackHub').load_member('Edda', 1000, true)"},
    {"eval": "Session.get_node('LoopbackHub').load_member('Ottilie', 1000, true)"},
    {"eval": "Session.get_node('LoopbackHub').load_member('Wen', 400, false)"},
    {"wait_until": "Session.client != null and Session.client.load_seconds >= 31", "timeout": 3000},
    {"assert": "Session.start_without_name() == ''", "msg": "past 30 s with Wen still loading, no Start without is offered to strangers"},
    {"eval": "Session._party('start')"},
    {"wait": 60},
    {"assert": "Session.state_name() == 'LOADING' and not Session.get_node('LoopbackHub').seq.started_without", "msg": "a start sent anyway changes nothing"}
  ]
}
