{
  "name": "next_wave_starts",
  "seed": 1,
  "time_scale": 8,
  "timeout_frames": 3000,
  "steps": [
    {"set": "Game.gold", "value": 400},
    {"eval": "scene.build('arrow', Vector2i(8, 3))"},
    {"eval": "scene.build('arrow', Vector2i(6, 3))"},
    {"eval": "scene.build('cannon', Vector2i(8, 5))"},
    {"wait_until": "Game.state == 1 and Game.wave == 1", "timeout": 200},
    {"wait_until": "Game.state == 0", "timeout": 1500},
    {"assert": "Game.wave == 1 and Game.lives == 20", "msg": "wave 1 is cleared without leaks"},
    {"assert": "absf(Game.countdown - Game.BETWEEN_WAVES) < 0.5", "msg": "a fresh build countdown starts"},
    {"assert": "screen_has('Wave 1 cleared')", "msg": "the clear is announced"},
    {"wait_until": "Game.state == 1", "timeout": 200},
    {"assert": "Game.wave == 2", "msg": "the countdown runs out and wave 2 starts by itself"},
    {"wait_until": "count('creeps') > 0", "timeout": 60},
    {"assert": "screen_has('Wave 2')", "msg": "the new wave is announced"}
  ]
}
