{
  "name": "build_by_click",
  "seed": 1,
  "observe_groups": [
    "towers",
    "landmarks"
  ],
  "observe_props": [
    "kind",
    "level",
    "kills"
  ],
  "watch": {
    "hash": "scene.state_hash_hex()"
  },
  "steps": [
    {
      "wait": 5
    },
    {
      "eval": "Game.gold",
      "as": "start_gold"
    },
    {
      "key": "A"
    },
    {
      "assert": "node('BuildController').mode == 'arrow'",
      "msg": "A enters arrow build mode"
    },
    {
      "hover": "scene.cell_center(Vector2i(8, 3))"
    },
    {
      "capture": "ghost_on_grass",
      "overlay": true
    },
    {
      "assert": "node('BuildController').hover_cell == Vector2i(8, 3)",
      "msg": "hover picks the cell under the mouse"
    },
    {
      "set_ticks_per_frame": 0
    },
    {
      "click": "scene.cell_center(Vector2i(8, 3))"
    },
    {
      "assert": "not scene.settled() and node('Pending_8_3') != null and scene.tower_at(Vector2i(8, 3)) == null",
      "msg": "while the order waits for its turn the tower stands as a ghost"
    },
    {
      "assert": "Game.gold == start_gold and text('Gold') == str(start_gold - 40)",
      "msg": "and its cost already shows as spent, though nothing is paid yet"
    },
    {
      "capture": "pending_ghost",
      "overlay": true
    },
    {
      "set_ticks_per_frame": 1
    },
    {
      "wait_until": "scene.settled()",
      "timeout": 12
    },
    {
      "assert": "scene.tower_at(Vector2i(8, 3)) != null",
      "msg": "clicking a grass cell builds once the turn comes"
    },
    {
      "assert": "Game.gold == start_gold - 40",
      "msg": "an arrow tower costs 40"
    },
    {
      "assert": "node('Pending_8_3') == null",
      "msg": "the ghost gives way to the tower"
    },
    {
      "assert": "node('BuildController').mode == ''",
      "msg": "build mode ends after placing"
    },
    {
      "assert": "node('Decor').count_on(Vector2i(8, 3)) == 0",
      "msg": "fluff on the cell is cleared"
    },
    {
      "key": "C"
    },
    {
      "click": "scene.cell_center(Vector2i(7, 4))"
    },
    {
      "assert": "scene.settled() and scene.tower_at(Vector2i(7, 4)) == null",
      "msg": "road cells are not buildable, and nothing is sent"
    },
    {
      "assert": "Game.gold == start_gold - 40",
      "msg": "a refused build costs nothing"
    },
    {
      "key": "Escape"
    },
    {
      "set": "Game.gold",
      "value": 60
    },
    {
      "key": "C"
    },
    {
      "assert": "node('BuildController').mode == ''",
      "msg": "cannot pick a 70-gold cannon with 60 gold"
    },
    {
      "click": "scene.cell_center(Vector2i(9, 5))"
    },
    {
      "wait": 4
    },
    {
      "assert": "scene.tower_at(Vector2i(9, 5)) == null",
      "msg": "and clicking builds nothing"
    },
    {
      "wait": 20
    },
    {
      "capture": "after",
      "overlay": true
    }
  ]
}
