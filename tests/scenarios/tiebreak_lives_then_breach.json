{
  "name": "tiebreak_lives_then_breach",
  "description": "How a duel is decided (design 1.4, contract-m7 §2): two Lookouts that build nothing (empty plans, 100 lives each) let every creep through, and once seat 1 has uncorked the Moth Cloud on seat 2's road in wave 2 the hollows are set to wave 15 (a logged scenario setter), so that wave's clear is the end. With the lives left to fall as they will, team 0 has more and wins by 'lives'; with team 0's lives set 4 lower at the horn, both end on 68 and team 0's 4 lives of breach dealt win by 'breach'; with no cork, both end level on everything, a draw. A Holdfast that falls loses at once ('fell'); both on one tick are a draw.",
  "scene": "res://tests/sim/sim_harness.tscn",
  "seed": 1,
  "timeout_frames": 200,
  "steps": [
    {"eval": "{'mode': 'undertow', 'seats': 2, 'seed': 1, 'builders': ['lookout', 'lookout'], 'plans': {'lookout': []}}", "as": "cfg"},
    {"eval": "scene.start(cfg)"},
    {"eval": "[scene.debug(2, 0, 100), scene.debug(2, 1, 100)]"},
    {"eval": "scene.duel_to_window(2)"},
    {"eval": "scene.cork(1, 3, 0, 0)"},
    {"eval": "[scene.cmd(1, 'READY', 1), scene.cmd(2, 'READY', 1)]"},
    {"eval": "scene.run_to_horn()", "as": "horn"},
    {"eval": "scene.run_to(horn + 180)"},
    {"eval": "scene.uncork(1, 3, 0, 0)"},
    {"eval": "scene.run_ticks(3)"},
    {"eval": "[scene.debug(3, 0, 15), scene.debug(3, 1, 15)]"},
    {"eval": "scene.run_until_over()"},
    {"eval": "[scene.client(1).teams[0].lives, scene.client(1).teams[1].lives, scene.client(1).breach_dealt(0), scene.client(1).breach_dealt(1)]", "as": "a"},
    {"assert": "a == [72, 68, 4, 0] and scene.client(1).outcomes() == [0, 1] and scene.client(1).decided_by() == 'lives'", "msg": "more lives wins"},
    {"eval": "scene.start(cfg)"},
    {"eval": "[scene.debug(2, 0, 100), scene.debug(2, 1, 100)]"},
    {"eval": "scene.duel_to_window(2)"},
    {"eval": "scene.cork(1, 3, 0, 0)"},
    {"eval": "[scene.cmd(1, 'READY', 1), scene.cmd(2, 'READY', 1)]"},
    {"eval": "scene.run_to_horn()", "as": "horn"},
    {"eval": "scene.debug(2, 0, scene.client(1).teams[1].lives - 4)"},
    {"eval": "scene.run_to(horn + 180)"},
    {"eval": "scene.uncork(1, 3, 0, 0)"},
    {"eval": "scene.run_ticks(3)"},
    {"eval": "[scene.debug(3, 0, 15), scene.debug(3, 1, 15)]"},
    {"eval": "scene.run_until_over()"},
    {"eval": "[scene.client(1).teams[0].lives, scene.client(1).teams[1].lives, scene.client(1).breach_dealt(0), scene.client(1).breach_dealt(1)]", "as": "b"},
    {"assert": "b == [68, 68, 4, 0] and scene.client(1).outcomes() == [0, 1] and scene.client(1).decided_by() == 'breach'", "msg": "level on lives, more breach dealt wins"},
    {"eval": "scene.start(cfg)"},
    {"eval": "[scene.debug(2, 0, 100), scene.debug(2, 1, 100)]"},
    {"eval": "scene.duel_to_window(2)"},
    {"eval": "[scene.cmd(1, 'READY', 1), scene.cmd(2, 'READY', 1)]"},
    {"eval": "scene.run_to_horn()"},
    {"eval": "[scene.debug(3, 0, 15), scene.debug(3, 1, 15)]"},
    {"eval": "scene.run_until_over()"},
    {"assert": "scene.client(1).teams[0].lives == 72 and scene.client(1).teams[1].lives == 72 and scene.client(1).outcomes() == [2, 2] and scene.client(1).decided_by() == 'draw'", "msg": "level on both, a draw"},
    {"eval": "scene.start(cfg)"},
    {"eval": "[scene.cmd(1, 'READY', 1), scene.cmd(2, 'READY', 1)]"},
    {"eval": "scene.run_to_horn()"},
    {"eval": "scene.debug(2, 1, 0)"},
    {"eval": "scene.run_ticks(1)"},
    {"assert": "scene.client(1).over and scene.client(1).outcomes() == [0, 1] and scene.client(1).decided_by() == 'fell' and scene.client(1).hollows[0].wave == 1", "msg": "a Holdfast that falls loses at once, in wave 1"},
    {"eval": "scene.start(cfg)"},
    {"eval": "[scene.cmd(1, 'READY', 1), scene.cmd(2, 'READY', 1)]"},
    {"eval": "scene.run_to_horn()"},
    {"eval": "[scene.debug(2, 0, 0), scene.debug(2, 1, 0)]"},
    {"eval": "scene.run_ticks(1)"},
    {"assert": "scene.client(1).over and scene.client(1).outcomes() == [2, 2] and scene.client(1).decided_by() == 'draw'", "msg": "both on one tick: a draw"}
  ]
}
