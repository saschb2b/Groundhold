{
  "name": "flow_difficulty_party_and_queue",
  "description": "The party's level through the lobby fake (M8, contract-m8 §3 and §5; design 2.6, 5.2): the profile at Hard makes a party that starts at Hard (PARTY create, then PARTY difficulty); the leader's Very Hard reaches the party and clears the member's Ready, and Hard again; a mode change to Undertow keeps the party's level (a duel takes none) and High Water plays it again; queued with open seats, two strangers at Normal never fill the Hard party's seats, two at Hard do: Match Found, the match of strangers, and MATCH_CONFIG's level 1 reaches the client (difficulty, the rules its simulation is built from, the session's match_spec); the Normal strangers wait on; after the match the party is back at Hard.",
  "seed": 1,
  "timeout_frames": 5000,
  "steps": [
    {"eval": "resource('res://scripts/net/match_rules.gd')", "as": "MR"},
    {"wait": 3},
    {"set": "node('NameField').text", "value": "Sascha"},
    {"key": "Enter"},
    {"eval": "Session.add_child(resource('res://tests/net/loopback_hub.gd').new())"},
    {"eval": "Session.get_node('LoopbackHub').start({})"},
    {"assert": "Session.offers_difficulty('high_water') and Session.offers_difficulty('tide_race') and not Session.offers_difficulty('undertow') and not Session.offers_difficulty('classic')", "msg": "High Water and Tide Race take a level, a duel and classic do not (protocol.json's levels)"},
    {"eval": "Session.set_difficulty('hard')"},
    {"assert": "Session.difficulty_id() == 'hard' and Session.profile.difficulty == 'hard'", "msg": "a party of one: the profile's level"},
    {"eval": "Session.create_party()"},
    {"wait_until": "Session.party_code() == 'K7Q4M' and Session.party.get('difficulty', '') == 'hard'", "timeout": 120},
    {"eval": "Session.get_node('LoopbackHub').seq", "as": "seq"},
    {"assert": "seq.party_log.slice(0, 2) == [[-1, 'create'], [0, 'difficulty']] and int(seq.party['difficulty']) == 1", "msg": "a new party starts at its creator's level: PARTY difficulty right after the create"},
    {"eval": "Session.get_node('LoopbackHub').member('Edda', 'lookout')"},
    {"eval": "Session.get_node('LoopbackHub').set_member('Edda', 'ready', true)"},
    {"wait_until": "Session.party_size() == 2 and Session.not_ready_names().is_empty()", "timeout": 60},
    {"eval": "Session.set_difficulty('very_hard')"},
    {"wait_until": "Session.difficulty_id() == 'very_hard'", "timeout": 60},
    {"assert": "Session.not_ready_names() == ['Edda'] and not seq.member_conn('Edda')['ready']", "msg": "the leader's change clears every Ready"},
    {"eval": "Session.set_difficulty('hard')"},
    {"wait_until": "Session.difficulty_id() == 'hard'", "timeout": 60},
    {"eval": "Session.set_mode('undertow')"},
    {"wait_until": "Session.mode_id() == 'undertow'", "timeout": 60},
    {"assert": "Session.difficulty_id() == 'hard' and Session.offline_match('undertow', 'lamplighter')['difficulty'] == 'normal'", "msg": "the party keeps its level through a mode change; a duel plays Normal"},
    {"eval": "Session.set_mode('high_water')"},
    {"wait_until": "Session.mode_id() == 'high_water' and Session.difficulty_id() == 'hard'", "timeout": 60},
    {"eval": "Session.get_node('LoopbackHub').set_member('Edda', 'ready', true)"},
    {"eval": "Session.set_open(true)"},
    {"wait_until": "node('HubPanel').primary_text() == 'Find players' and Session.not_ready_names().is_empty()", "timeout": 60},
    {"eval": "Session.enter_queue()"},
    {"wait_until": "Session.state_name() == 'QUEUED'", "timeout": 60},
    {"eval": "Session.set_difficulty('normal')"},
    {"wait": 10},
    {"assert": "Session.difficulty_id() == 'hard' and int(seq.party['difficulty']) == 1 and Session.state_name() == 'QUEUED'", "msg": "queued, the leader's change is refused: the party stays at Hard and in the queue"},
    {"eval": "Session.set_difficulty('hard')"},
    {"eval": "Session.get_node('LoopbackHub').stranger('Ottilie', 'bellfounder', 'lookout', true, 'normal')"},
    {"eval": "Session.get_node('LoopbackHub').stranger('Wen', 'beekeeper', 'lookout', true, 'normal')"},
    {"wait": 30},
    {"assert": "Session.state_name() == 'QUEUED' and seq.found.is_empty() and seq.founds_sent == 0", "msg": "two strangers at Normal would fill the seats, but the level is the queue's key: no Match Found"},
    {"eval": "Session.get_node('LoopbackHub').stranger('Bram', 'bellfounder', 'lookout', true, 'hard')"},
    {"eval": "Session.get_node('LoopbackHub').stranger('Cai', 'beekeeper', 'lookout', true, 'hard')"},
    {"wait_until": "Session.state_name() == 'MATCH_FOUND'", "timeout": 60},
    {"eval": "Session.accept_match()"},
    {"eval": "Session.get_node('LoopbackHub').member_answer('Edda', true)"},
    {"wait_until": "Session.state_name() == 'LOADING' and Session.client.sim != null", "timeout": 120},
    {"assert": "Session.client.names == ['Sascha', 'Edda', 'Bram', 'Cai']", "msg": "the strangers at the party's level filled its seats"},
    {"assert": "int(Session.client.config['difficulty']) == 1 and Session.client.difficulty == 'hard'", "msg": "MATCH_CONFIG names the level the match plays: Hard"},
    {"assert": "Session.client.sim.rules['difficulty'] == 'hard' and MR.level_problem(Session.client.sim.rules) == '' and Session.match_spec['difficulty'] == 'hard'", "msg": "the client's simulation is built at that level, its numbers Hard's by the rules track's table, and the match scene is told it"},
    {"assert": "seq.strangers.size() == 2 and seq.strangers[0]['name'] == 'Ottilie' and seq.strangers[1]['name'] == 'Wen'", "msg": "the strangers at Normal wait on"},
    {"eval": "Session.get_node('LoopbackHub').load_member('Edda', 1000, true)"},
    {"wait_until": "Session.state_name() == 'IN_MATCH'", "timeout": 900},
    {"wait": 20},
    {"eval": "Session.get_node('LoopbackHub').finish('lost')"},
    {"wait_until": "Session.state_name() == 'RESULTS' and node('ResultsPanel') != null", "timeout": 120},
    {"click": "node('ResultsPlayAgain')"},
    {"wait_until": "scene_path() == 'res://scenes/hub.tscn' and node('HubPanel') != null", "timeout": 120},
    {"wait_until": "Session.state_name() == 'HUB'", "timeout": 120},
    {"assert": "Session.difficulty_id() == 'hard' and Session.party['difficulty'] == 'hard'", "msg": "back from the match, the party is still at Hard"}
  ]
}
