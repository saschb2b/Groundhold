{
  "name": "flow_match_found_dissolves_decline_and_timeout",
  "description": "Match Found dissolving (design 5.5). A stranger declines after I accepted: NOTICE match_dissolved ('A player didn't accept. You keep your place.'), the overlay goes and I am queued again at the front, my time kept. Found again, I let the server's 15 s run out: my party goes back to forming, the hub's Find players again, the strangers stay queued. Queued once more they are found at once, and Esc declines.",
  "seed": 1,
  "timeout_frames": 4000,
  "steps": [
    {"wait": 3},
    {"set": "node('NameField').text", "value": "Sascha"},
    {"key": "Enter"},
    {"eval": "Session.add_child(resource('res://tests/net/loopback_hub.gd').new())"},
    {"eval": "Session.get_node('LoopbackHub').start({})"},
    {"eval": "Session.create_party()"},
    {"wait_until": "Session.party_code() == 'K7Q4M'", "timeout": 120},
    {"eval": "Session.set_open(true)"},
    {"wait_until": "node('HubPanel').primary_text() == 'Find players'", "timeout": 60},
    {"eval": "Session.play()"},
    {"wait_until": "Session.state_name() == 'QUEUED'", "timeout": 60},
    {"wait": 120},
    {"eval": "Session.get_node('LoopbackHub').stranger('Edda', 'lookout', 'lamplighter')"},
    {"eval": "Session.get_node('LoopbackHub').stranger('Ben', 'lamplighter', 'lookout', false)"},
    {"eval": "Session.get_node('LoopbackHub').stranger('Wen', 'beekeeper', 'lookout')"},
    {"wait_until": "Session.state_name() == 'MATCH_FOUND'", "timeout": 60},
    {"wait": 1},
    {"assert": "Session.get_node('MatchFound').lines()[2] == '2 of 4'", "msg": "two strangers accepted at once; Ben has not answered"},
    {"eval": "Session.accept_match()"},
    {"wait_until": "Session.found.get('accepted', 0) == 3", "timeout": 60},
    {"assert": "Session.get_node('MatchFound').lines()[2] == '3 of 4' and Session.get_node('MatchFound').lines()[4] == 'Accepted'", "msg": "my accept counted"},
    {"eval": "Session.get_node('LoopbackHub').stranger_answer('Ben', false)"},
    {"wait_until": "Session.state_name() == 'QUEUED'", "timeout": 60},
    {"wait": 1},
    {"assert": "Session.last_notice == \"A player didn't accept. You keep your place.\"", "msg": "the notice says I keep my place"},
    {"assert": "Session.get_node_or_null('MatchFound') == null and Session.found.is_empty()", "msg": "the overlay goes"},
    {"assert": "Session.queue_ms() >= 2000 and node('Shell').pill_text().begins_with('Finding players 0:0')", "msg": "queued again, at the front, my time kept"},
    {"assert": "Session.get_node('LoopbackHub').seq.strangers.size() == 2", "msg": "Ben, who declined, left the queue"},
    {"eval": "Session.get_node('LoopbackHub').stranger('Cy', 'lookout', 'lamplighter')"},
    {"wait_until": "Session.state_name() == 'MATCH_FOUND'", "timeout": 60},
    {"wait": 840},
    {"assert": "Session.state_name() == 'MATCH_FOUND' and Session.found_seconds() <= 2", "msg": "the server's window nearly out"},
    {"wait_until": "Session.state_name() == 'HUB'", "timeout": 200},
    {"wait": 2},
    {"assert": "Session.party['phase'] == 'forming' and Session.get_node_or_null('MatchFound') == null", "msg": "I did not answer: my party back to forming"},
    {"assert": "node('HubPanel').primary_text() == 'Find players' and node('Shell').pill_text() == ''", "msg": "the hub as before the queue"},
    {"assert": "Session.get_node('LoopbackHub').seq.strangers.size() == 3", "msg": "the strangers who accepted stay queued"},
    {"eval": "Session.play()"},
    {"wait_until": "Session.state_name() == 'MATCH_FOUND' and Session.get_node_or_null('MatchFound') != null", "timeout": 60},
    {"key": "Escape"},
    {"wait_until": "Session.state_name() == 'HUB'", "timeout": 60},
    {"assert": "Session.get_node('LoopbackHub').seq.ticket.is_empty() and Session.party['phase'] == 'forming'", "msg": "Esc declined: out of the queue"}
  ]
}
