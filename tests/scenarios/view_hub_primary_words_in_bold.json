{
  "name": "view_hub_primary_words_in_bold",
  "description": "The hub's one button sets its words in Noto Serif Bold, the face every other socket uses: in the display face at 13 px with its 3 px outline the hairline tail of 'y' was lost, so the button read 'Plav', 'Readv' and 'Not readv' (review round 2). The countdown's large digit keeps the display face. Captured rendered: alone (Play), a member (Ready, Not ready) and the leader's countdown.",
  "seed": 1,
  "timeout_frames": 1200,
  "steps": [
    {"wait": 3},
    {"set": "node('NameField').text", "value": "Sascha"},
    {"key": "Enter"},
    {"wait": 2},
    {"assert": "(node('HubPanel').primary_text() == 'Play') and (node('Primary').get_node('Words').get_theme_font('font').resource_path == 'res://fonts/NotoSerif-Bold.ttf')", "msg": "alone: Play, in Noto Serif Bold"},
    {"assert": "node('Primary').get_node('Words').get_theme_font_size('font_size') >= 14", "msg": "a size up from the other sockets' words, so the call to action keeps its weight"},
    {"capture": "hub_alone_primary_play_bold"},
    {"eval": "Session.add_child(resource('res://tests/net/loopback_hub.gd').new())"},
    {"eval": "Session.get_node('LoopbackHub').start({})"},
    {"eval": "Session.get_node('LoopbackHub').host('Ana', 'lookout')"},
    {"assert": "Session.join_code('k7q-4m')", "msg": "a code joins Ana's party"},
    {"wait_until": "Session.party_size() == 2 and Session.me >= 0", "timeout": 120},
    {"wait": 2},
    {"assert": "(node('HubPanel').primary_text() == 'Ready') and (node('Primary').get_node('Words').get_theme_font('font').resource_path == 'res://fonts/NotoSerif-Bold.ttf')", "msg": "a member: Ready, in Noto Serif Bold"},
    {"capture": "hub_member_primary_ready_bold"},
    {"click": "node('Primary')"},
    {"wait_until": "node('HubPanel').primary_text() == 'Not ready'", "timeout": 60},
    {"wait": 2},
    {"assert": "node('Primary').get_node('Words').get_theme_font('font').resource_path == 'res://fonts/NotoSerif-Bold.ttf'", "msg": "Not ready, in Noto Serif Bold"},
    {"capture": "hub_member_primary_not_ready_bold"},
    {"eval": "Session._party('leave')"},
    {"wait_until": "Session.party.is_empty()", "timeout": 60},
    {"eval": "Session.create_party()"},
    {"wait_until": "(not Session.party.is_empty()) and Session.is_leader() and Session.party_size() == 1", "timeout": 120},
    {"eval": "Session.get_node('LoopbackHub').member('Ben', 'lookout')"},
    {"eval": "Session.get_node('LoopbackHub').set_member('Ben', 'ready', true)"},
    {"wait_until": "not node('Primary').disabled and node('HubPanel').primary_text() == 'Start'", "timeout": 120},
    {"assert": "node('Primary').get_node('Words').get_theme_font('font').resource_path == 'res://fonts/NotoSerif-Bold.ttf'", "msg": "the leader's Start, in Noto Serif Bold"},
    {"click": "node('Primary')"},
    {"wait_until": "Session.state_name() == 'COUNTDOWN'", "timeout": 60},
    {"wait": 2},
    {"assert": "(node('Primary').get_node('Words').get_theme_font('font').resource_path == 'res://fonts/NotoSerifDisplay-Bold.ttf') and (node('Primary').get_node('Words').get_theme_font_size('font_size') == 24)", "msg": "the countdown's large digit keeps the display face"},
    {"capture": "hub_leader_countdown_digit_display_face"}
  ]
}
