{
  "name": "flow_hub_link_lost_after_match",
  "description": "Back in the party after a match (Play again), the server's link goes. The game goes offline, a party of one, and the hub says the party went with the link, in the same words as after the results plate, rather than the link's raw reason (review M5 round 2).",
  "seed": 1,
  "timeout_frames": 3000,
  "steps": [
    {"wait": 3},
    {"set": "node('NameField').text", "value": "Sascha"},
    {"key": "Enter"},
    {"eval": "Session.add_child(resource('res://tests/net/loopback_hub.gd').new())"},
    {"eval": "Session.get_node('LoopbackHub').start({})"},
    {"eval": "Session.create_party()"},
    {"wait_until": "Session.party_code() == 'K7Q4M'", "timeout": 120},
    {"eval": "Session.get_node('LoopbackHub').member('Ana', 'lookout')"},
    {"eval": "Session.get_node('LoopbackHub').set_member('Ana', 'ready', true)"},
    {"wait_until": "not node('Primary').disabled and node('HubPanel').primary_text() == 'Start'", "timeout": 60},
    {"click": "node('Primary')"},
    {"wait_until": "scene_path() == 'res://scenes/main.tscn'", "timeout": 400},
    {"eval": "Session.get_node('LoopbackHub').load_member('Ana', 1000, true)"},
    {"wait_until": "Session.state_name() == 'IN_MATCH'", "timeout": 600},
    {"wait": 30},
    {"eval": "Session.get_node('LoopbackHub').finish('won')"},
    {"wait_until": "Session.state_name() == 'RESULTS' and node('ResultsPanel') != null", "timeout": 60},
    {"click": "node('ResultsPlayAgain')"},
    {"wait_until": "scene_path() == 'res://scenes/hub.tscn'", "timeout": 60},
    {"wait_until": "Session.party.get('phase', '') == 'forming'", "timeout": 60},
    {"wait": 10},
    {"assert": "Session.state_name() == 'HUB' and Session.party_size() == 2", "msg": "back in the party"},
    {"eval": "Session.get_node('LoopbackHub').cut()"},
    {"wait": 10},
    {"assert": "Session.state_name() == 'OFFLINE' and Session.client == null and Session.party_size() == 1", "msg": "offline, a party of one"},
    {"assert": "node('Place').text == 'Offline' and Session.last_notice == 'Your link was lost, and the party with it.'", "msg": "the hub says the party went with the link"},
    {"assert": "node('Notice').visible and node('Notice').text == Session.last_notice", "msg": "on screen"},
    {"assert": "str(node('HubPanel').lines()).find('Ana') < 0", "msg": "no stale members"},
    {"capture": "hub_link_lost_after_match"}
  ]
}
