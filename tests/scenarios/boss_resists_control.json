{
  "name": "boss_resists_control",
  "description": "Control resistance (design 2.4) shrinks every slow on a boss in High Water: the Frost Spire's 45% is 31.5% on the Bristlesow (30% resistance) and 22.5% on the Hollowtide Crest (50%), and stays 45% on a Gourdling; the Pinning Ballista's 50% is 35% on the Bristlesow. Classic turns resistance off: 45% on the Crest.",
  "scene": "res://tests/sim/sim_harness.tscn",
  "seed": 1,
  "timeout_frames": 60,
  "steps": [
    {"eval": "scene.start({'mode': 'high_water', 'seats': 2, 'builders': ['lamplighter', 'lookout']})"},
    {"eval": "[scene.debug(1, 1, 1000), scene.debug(1, 2, 1000)]"},
    {"eval": "scene.cmd(1, 'BUILD', 2, 5, 3)"},
    {"eval": "scene.run_ticks(6)"},
    {"eval": "scene.spawn('bristlesow', 3000000)", "as": "boar"},
    {"eval": "scene.hold(boar)"},
    {"eval": "scene.run_ticks(90)"},
    {"eval": "scene.debug(5, boar, 45000000)"},
    {"eval": "scene.spawn('hollowtide_crest', 3000000)", "as": "crest"},
    {"eval": "scene.hold(crest)"},
    {"eval": "scene.run_ticks(90)"},
    {"eval": "scene.debug(5, crest, 46000000)"},
    {"eval": "scene.spawn('gourdling', 3000000)", "as": "gourdling"},
    {"eval": "scene.hold(gourdling)"},
    {"eval": "scene.run_ticks(90)"},
    {"eval": "[scene.status_amounts(boar, 1), scene.status_amounts(crest, 1), scene.status_amounts(gourdling, 1)]", "as": "frost"},
    {"assert": "frost == [[315], [225], [450]]", "msg": "the Frost Spire slows the Bristlesow 31.5%, the Crest 22.5% and a Gourdling 45%"},
    {"assert": "scene.creep(crest).slow_pm == 225", "msg": "and that is what the Crest walks with"},
    {"eval": "scene.debug(5, gourdling, 47000000)"},
    {"eval": "scene.cmd(2, 'BUILD', 0, 5, 1)"},
    {"eval": "scene.run_ticks(6)"},
    {"eval": "scene.cmd(2, 'FORK', scene.tower_at(5, 1).id, 1)"},
    {"eval": "scene.run_ticks(6)"},
    {"eval": "scene.debug(5, boar, 3000000)"},
    {"eval": "scene.run_ticks(150)"},
    {"assert": "scene.status_amounts(boar, 1).has(350) and scene.events_where('STATUS', {'creep': boar, 'effect': 1, 'amount': 350, 'seat': 2}).size() > 0", "msg": "the Pinning Ballista's 50% is 35% on the Bristlesow"},
    {"eval": "scene.start({'mode': 'classic', 'seats': 1})"},
    {"eval": "scene.cmd(1, 'BUILD', 2, 5, 3)"},
    {"eval": "scene.run_ticks(6)"},
    {"eval": "scene.spawn('hollowtide_crest', 3000000)", "as": "classic_crest"},
    {"eval": "scene.hold(classic_crest)"},
    {"eval": "scene.run_ticks(90)"},
    {"assert": "scene.status_amounts(classic_crest, 1) == [450]", "msg": "classic keeps M1's rule: no resistance"}
  ]
}
