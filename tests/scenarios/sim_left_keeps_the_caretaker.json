{
  "name": "sim_left_keeps_the_caretaker",
  "description": "LEFT keeps the caretaker to the end (design 6.7, M4): a Lamplighter who leaves in wave 2 never gets the seat back. A later BACK or AWAY for it moves nothing and says nothing, no build window hands it back, every order still sent in its name is refused with CARETAKEN, and the caretaker keeps building and forking her plan with her gold through the last waves, never selling, until the match ends with the seat still left. A seat that was returning when LEFT came stays left past the window that would have handed it back.",
  "scene": "res://tests/sim/sim_harness.tscn",
  "seed": 1,
  "timeout_frames": 3000,
  "watch": {"hash1": "scene.client(1).state_hash_hex()"},
  "steps": [
    {"eval": "scene.start({'mode': 'high_water', 'seats': 2, 'clients': 1, 'seed': 6})"},
    {"repeat": 400, "steps": [{"eval": "scene.plan_step(1)"}, {"eval": "scene.plan_step(2)"}, {"eval": "scene.run_ticks(30)"}], "until": "scene.client(1).hollows[0].wave == 2 and scene.client(1).hollows[0].phase == 1"},
    {"eval": "scene.client(1).tick", "as": "left_at"},
    {"eval": "scene.system('LEFT', 2)"},
    {"eval": "scene.run_turns(10)"},
    {"eval": "scene.system('BACK', 2)"},
    {"eval": "scene.run_turns(10)"},
    {"eval": "scene.system('AWAY', 2)"},
    {"eval": "scene.run_turns(10)"},
    {"assert": "scene.seat_moves(2) == [[left_at, 'left']] and scene.seat_state(2) == 'left'", "msg": "LEFT moved the seat once; BACK and AWAY after it moved nothing and said nothing"},
    {"eval": "scene.road_cell()", "as": "road"},
    {"repeat": 400, "steps": [{"eval": "scene.plan_step(1)"}, {"eval": "scene.cmd(2, 'BUILD', 0, road[0], road[1])"}, {"eval": "scene.run_ticks(300)"}], "until": "scene.client(1).hollows[0].wave >= 9"},
    {"eval": "scene.client(1).tick", "as": "wave9_at"},
    {"repeat": 400, "steps": [{"eval": "scene.plan_step(1)"}, {"eval": "scene.cmd(2, 'BUILD', 0, road[0], road[1])"}, {"eval": "scene.run_ticks(300)"}], "until": "scene.client(1).over"},
    {"eval": "[scene.client(1).hollows[0].wave, scene.client(1).hollows[0].phase, scene.client(1).teams[0].lives]", "as": "end"},
    {"assert": "scene.client(1).over and scene.seat_state(2) == 'left' and scene.seat_moves(2).size() == 1", "msg": "the match ended with the seat still left: no window handed it back"},
    {"eval": "scene.since(scene.refusal_ticks(2), left_at)", "as": "refused"},
    {"assert": "refused.size() >= 20 and scene.refusals(2).count('CARETAKEN') == refused.size()", "msg": "every order sent in its name was refused with CARETAKEN"},
    {"eval": "scene.since(scene.events_where('BUILT', {'seat': 2}), left_at).size() + scene.since(scene.events_where('FORKED', {'seat': 2}), left_at).size()", "as": "orders"},
    {"eval": "scene.since(scene.events_where('BUILT', {'seat': 2}), wave9_at).size() + scene.since(scene.events_where('FORKED', {'seat': 2}), wave9_at).size()", "as": "late_orders"},
    {"assert": "orders >= 6 and late_orders >= 1", "msg": "the caretaker kept building and forking her plan, into the last waves"},
    {"assert": "scene.events_where('SOLD', {'seat': 2}).size() == 0", "msg": "and never sold"},
    {"eval": "scene.start({'mode': 'high_water', 'seats': 2, 'clients': 2, 'seed': 6})"},
    {"repeat": 400, "steps": [{"eval": "scene.plan_step(1)"}, {"eval": "scene.plan_step(2)"}, {"eval": "scene.run_ticks(30)"}], "until": "scene.client(1).hollows[0].wave == 2 and scene.client(1).hollows[0].phase == 1"},
    {"eval": "scene.system('AWAY', 2)"},
    {"eval": "scene.run_turns(10)"},
    {"eval": "scene.system('BACK', 2)"},
    {"eval": "scene.run_turns(10)"},
    {"assert": "scene.seat_state(2) == 'returning'", "msg": "away, then back: returning until the next window"},
    {"eval": "scene.system('LEFT', 2)"},
    {"repeat": 400, "steps": [{"eval": "scene.run_ticks(30)"}], "until": "scene.client(1).hollows[0].wave == 3"},
    {"eval": "scene.seat_moves(2)", "as": "moves"},
    {"assert": "moves.size() == 3 and moves[0][1] == 'away' and moves[1][1] == 'returning' and moves[2][1] == 'left' and scene.seat_state(2) == 'left' and scene.seat_state(2, 2) == 'left'", "msg": "LEFT while returning: the window that opened after it did not hand the seat back"},
    {"assert": "scene.hashes_agree() and scene.record_differences(1, 2) == []", "msg": "both clients agree"}
  ]
}
