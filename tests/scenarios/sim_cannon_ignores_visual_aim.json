{
  "scene": "res://scenes/main.tscn",
  "name": "sim_cannon_ignores_visual_aim",
  "description": "Spinning the cannon's barrel model while it fires changes no landing point: the shells land where the bare simulation lands them.",
  "seed": 1,
  "timeout_frames": 1500,
  "observe_groups": [
    "towers"
  ],
  "observe_props": [
    "kind",
    "shots",
    "kills"
  ],
  "watch": {
    "tick": "scene.sim.tick",
    "hash": "scene.state_hash_hex()"
  },
  "steps": [
    {
      "set": "Game.gold",
      "value": 300
    },
    {
      "eval": "scene.build('cannon', Vector2i(6, 3))"
    },
    {
      "eval": "scene.build('cannon', Vector2i(8, 5))"
    },
    {
      "wait_until": "scene.settled()",
      "timeout": 12
    },
    {
      "set": "Game.countdown",
      "value": 0.1
    },
    {
      "repeat": 900,
      "steps": [
        {
          "eval": "scene.tower_at(Vector2i(6, 3))._head.set('rotation', Vector3(0, frame * 1.7, 0))"
        },
        {
          "eval": "scene.tower_at(Vector2i(8, 5))._head.set('rotation', Vector3(0, -frame * 2.3, 0))"
        },
        {
          "wait": 1
        }
      ],
      "until": "scene.sim.tick >= 1500"
    },
    {
      "assert": "scene.tower_at(Vector2i(6, 3)).shots + scene.tower_at(Vector2i(8, 5)).shots >= 6",
      "msg": "the cannons fired while their barrels spun"
    },
    {
      "assert": "scene.replay_matches()",
      "msg": "every shell landed where the bare simulation lands it"
    }
  ]
}
