{
  "scene": "res://scenes/main.tscn",
  "name": "view_shots_by_form",
  "description": "Every tower form sends its own shot's model (design 3.7): the Perch Ballista a ballista bolt, the Pinning Ballista its tethered bolt, the Hawk Roost a hawk, the Kestrel Flock a kestrel that flies on from the creep it struck to the next (a bounce starts at the creep, not the roost), the Iron Mortar a mortar shell on an arc. The Owl's Eye fires nothing while it marks.",
  "seed": 1,
  "timeout_frames": 1200,
  "watch": {"hash": "scene.state_hash_hex()"},
  "steps": [
    {"eval": "scene.begin('high_water', [{'team': 0, 'builder': 'lamplighter'}, {'team': 0, 'builder': 'lookout'}], 1, resource('res://scripts/net/local_sequencer.gd').new(2, 1), 1)"},
    {"wait": 2},
    {"set": "Game.countdown", "value": 90},
    {"set": "Game.gold", "value": 3000},
    {"eval": "Game.debug(1, 2, 3000)"},
    {"eval": "scene.source.submit_as(2, 1, 0, 10, 7)"},
    {"eval": "scene.source.submit_as(2, 1, 0, 12, 7)"},
    {"eval": "scene.source.submit_as(2, 1, 1, 14, 7)"},
    {"eval": "scene.source.submit_as(2, 1, 1, 16, 7)"},
    {"eval": "scene.source.submit_as(2, 1, 2, 13, 8)"},
    {"eval": "scene.source.submit(1, 1, 14, 5)"},
    {"wait_until": "count('towers') == 6", "timeout": 30},
    {"eval": "scene.source.submit_as(2, 2, scene.tower_at(Vector2i(12, 7)).id, 1)"},
    {"eval": "scene.source.submit_as(2, 2, scene.tower_at(Vector2i(16, 7)).id, 1)"},
    {"eval": "scene.source.submit(2, scene.tower_at(Vector2i(14, 5)).id, 1)"},
    {"wait_until": "scene.sim.seat(1).forks + scene.sim.seat(2).forks == 3", "timeout": 30},
    {"wait": 2},
    {
      "assert": "scene.tower_at(Vector2i(12, 7)).form == 'pinning_ballista' and scene.tower_at(Vector2i(16, 7)).form == 'kestrel_flock' and scene.tower_at(Vector2i(14, 5)).form == 'iron_mortar'",
      "msg": "the forks stand"
    },
    {"eval": "scene.spawn('gourdling')"},
    {"wait": 1},
    {"eval": "scene.spawn('gourdling')"},
    {"wait": 1},
    {"eval": "scene.spawn('duskmoth')"},
    {"wait": 1},
    {"eval": "scene.spawn('duskmoth')"},
    {"wait": 1},
    {"eval": "scene.spawn('thornback')"},
    {"wait": 2},
    {"assert": "count('creeps') == 5", "msg": "five creeps stand at the Welling, out of every tower's reach"},
    {"eval": "group('creeps')", "as": "cs"},
    {"set": "cs[0].speed", "value": 0.0},
    {"set": "cs[1].speed", "value": 0.0},
    {"set": "cs[2].speed", "value": 0.0},
    {"set": "cs[3].speed", "value": 0.0},
    {"set": "cs[4].speed", "value": 0.0},
    {"set": "cs[0].distance", "value": 13.0},
    {"set": "cs[1].distance", "value": 13.6},
    {"set": "cs[2].distance", "value": 15.0},
    {"set": "cs[3].distance", "value": 15.9},
    {"set": "cs[4].distance", "value": 14.3},
    {"wait_until": "count('projectiles') >= 3", "timeout": 300},
    {"capture": "lookout_shots_in_flight"},
    {
      "wait_until": "scene.tower_at(Vector2i(10, 7)).last_launch != '' and scene.tower_at(Vector2i(12, 7)).last_launch != '' and scene.tower_at(Vector2i(14, 7)).last_launch != '' and scene.tower_at(Vector2i(16, 7)).bounces_flown > 0 and scene.tower_at(Vector2i(14, 5)).last_launch != ''",
      "timeout": 600
    },
    {"assert": "scene.tower_at(Vector2i(10, 7)).last_launch == 'ballista_bolt'", "msg": "the Perch Ballista looses a ballista bolt"},
    {"assert": "scene.tower_at(Vector2i(12, 7)).last_launch == 'pinning_bolt'", "msg": "the Pinning Ballista its tethered bolt"},
    {"assert": "scene.tower_at(Vector2i(14, 7)).last_launch == 'hawk'", "msg": "the Hawk Roost a hawk"},
    {"assert": "scene.tower_at(Vector2i(16, 7)).last_launch == 'kestrel'", "msg": "the Kestrel Flock a kestrel"},
    {
      "assert": "scene.tower_at(Vector2i(16, 7)).last_bounce_start.distance_to(scene.tower_at(Vector2i(16, 7)).global_position) > 1.5",
      "msg": "and its kestrel flies on from the creep it struck, not from the roost"
    },
    {"assert": "scene.tower_at(Vector2i(14, 5)).last_launch == 'mortar_shell'", "msg": "the Iron Mortar lobs a mortar shell"},
    {"assert": "scene.tower_at(Vector2i(13, 8)).last_launch == '' and scene.tower_at(Vector2i(13, 8)).shots == 0", "msg": "the Owl's Eye fires nothing"}
  ]
}
