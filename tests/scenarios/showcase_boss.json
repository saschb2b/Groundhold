{
  "scene": "res://scenes/main.tscn",
  "name": "showcase_boss",
  "seed": 3,
  "ticks_per_frame": 2,
  "timeout_frames": 2400,
  "observe_groups": [
    "creeps"
  ],
  "observe_props": [
    "kind",
    "hp",
    "max_hp",
    "distance"
  ],
  "watch": {
    "hash": "scene.state_hash_hex()"
  },
  "steps": [
    {
      "set": "Game.gold",
      "value": 3000
    },
    {
      "eval": "resource('res://tests/bot.gd').new()",
      "as": "bot"
    },
    {
      "repeat": 20,
      "steps": [
        {
          "eval": "bot.step(scene)"
        },
        {
          "wait": 2
        }
      ],
      "until": "bot.done == 20 and scene.settled()"
    },
    {
      "assert": "bot.done == 20 and count('towers') == 10",
      "msg": "the whole build order fits the budget"
    },
    {
      "set": "Game.wave",
      "value": 7
    },
    {
      "set": "Game.countdown",
      "value": 0.1
    },
    {
      "wait_until": "Game.wave == 8 and count('creeps') >= 4",
      "timeout": 600
    },
    {
      "wait_until": "Game.wave == 8 and Game.spawns_left() == 0 and Game.creeps_left() == count('creeps')",
      "timeout": 900
    },
    {
      "capture": "boss_wave_overview"
    },
    {
      "wait_until": "Game.creeps_left() == 1",
      "timeout": 1200,
      "fatal": false
    },
    {
      "eval": "scene.camera.look_from(first('creeps').global_position, 9.0)"
    },
    {
      "wait": 20
    },
    {
      "capture": "boss_close"
    }
  ]
}
