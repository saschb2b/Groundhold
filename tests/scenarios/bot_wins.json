{
  "name": "bot_wins",
  "seed": 1,
  "time_scale": 8,
  "timeout_frames": 20000,
  "watch": {"wave": "Game.wave", "lives": "Game.lives", "gold": "Game.gold", "towers": "count('towers')",
            "plan_done": "vars.get('bot').done if vars.has('bot') else 0"},
  "steps": [
    {"eval": "resource('res://tests/bot.gd').new()", "as": "bot"},
    {"repeat": 2000, "steps": [{"eval": "bot.step(scene)"}, {"wait": 15}], "until": "Game.state >= 2"},
    {"observe": "end"},
    {"assert": "Game.state == 2", "msg": "a sensible build order wins all eight waves"},
    {"assert": "Game.lives >= 10", "msg": "and keeps at least half the lives"},
    {"assert": "bot.log.size() == bot.done", "msg": "every planned build and upgrade succeeded"}
  ]
}
