{
  "name": "bot_wins_stacking_lookout",
  "description": "Stacked waves (M8): the Lookout's plan bot alone, by command, Ready at once in every window and calling wave 5 during the wave before as its plan's stack list says, wins High Water with at least half the lives. Generated by tools/gen_balance_scenarios.py: edit the generator, not this file.",
  "scene": "res://tests/sim/sim_harness.tscn",
  "seed": 1,
  "timeout_frames": 60,
  "watch": {
    "summary": "scene.summary()",
    "leaks": "scene.leak_table()",
    "stacks": "scene.stack_summary()"
  },
  "steps": [
    {
      "eval": "scene.start({\"builders\": [\"lookout\"], \"events\": false, \"mode\": \"high_water\", \"seats\": 1})"
    },
    {
      "eval": "scene.play_out([1], 30, 120000, [1], {\"1\": \"plan\"})",
      "as": "end"
    },
    {
      "eval": "scene.summary()",
      "as": "summary"
    },
    {
      "eval": "scene.leak_table()",
      "as": "leaks"
    },
    {
      "assert": "scene.client(1).hollows[0].phase == 2 and scene.client(1).hollows[0].wave == 12",
      "msg": "the Holdfast stands after wave 12"
    },
    {
      "assert": "scene.client(1).teams[0].lives >= 10",
      "msg": "with at least 10 lives left"
    },
    {
      "assert": "scene.stack_summary(0)['count'] > 0",
      "msg": "it called a wave during a wave at least once"
    }
  ]
}
