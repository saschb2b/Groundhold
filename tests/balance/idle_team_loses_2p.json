{
  "name": "idle_team_loses_2p",
  "description": "A Lamplighter and a Lookout who each place their plan's first two towers and nothing else lose before the twelfth wave. Generated by tools/gen_balance_scenarios.py: edit the generator, not this file.",
  "scene": "res://tests/sim/sim_harness.tscn",
  "seed": 1,
  "timeout_frames": 60,
  "watch": {
    "summary": "scene.summary()",
    "leaks": "scene.leak_table()"
  },
  "steps": [
    {
      "eval": "scene.start({\"builders\": [\"lamplighter\", \"lookout\"], \"events\": false, \"mode\": \"high_water\", \"seats\": 2})"
    },
    {
      "eval": "[scene.cmd(1, 'BUILD', 0, 8, 11), scene.cmd(1, 'BUILD', 0, 11, 11), scene.cmd(2, 'BUILD', 1, 12, 8), scene.cmd(2, 'BUILD', 1, 6, 12)]"
    },
    {
      "eval": "scene.run_ticks(6)"
    },
    {
      "assert": "scene.client(1).towers.size() == 4",
      "msg": "each seat's two towers stand"
    },
    {
      "eval": "scene.play_out([])",
      "as": "end"
    },
    {
      "eval": "scene.summary()",
      "as": "summary"
    },
    {
      "eval": "scene.leak_table()",
      "as": "leaks"
    },
    {
      "assert": "scene.client(1).hollows[0].phase == 3",
      "msg": "the Holdfast falls"
    },
    {
      "assert": "scene.client(1).hollows[0].wave < 12",
      "msg": "before wave 12"
    }
  ]
}
