{
  "name": "bot_wins_hard_solo_beekeeper",
  "description": "Hard (M8): the Beekeeper alone, the caretaker playing her plan as at Normal, wins High Water at Hard with at least a third of the 15 lives. Generated by tools/gen_balance_scenarios.py: edit the generator, not this file.",
  "scene": "res://tests/sim/sim_harness.tscn",
  "seed": 1,
  "timeout_frames": 60,
  "watch": {
    "summary": "scene.summary()",
    "leaks": "scene.leak_table()"
  },
  "steps": [
    {
      "eval": "scene.start({\"builders\": [\"beekeeper\"], \"caretakers\": [1], \"difficulty\": \"hard\", \"events\": false, \"mode\": \"high_water\", \"seats\": 1})"
    },
    {
      "eval": "scene.play_out([])",
      "as": "end"
    },
    {
      "eval": "scene.summary()",
      "as": "summary"
    },
    {
      "eval": "scene.leak_table()",
      "as": "leaks"
    },
    {
      "assert": "scene.client(1).hollows[0].phase == 2 and scene.client(1).hollows[0].wave == 12",
      "msg": "the Holdfast stands after wave 12"
    },
    {
      "assert": "scene.client(1).teams[0].lives >= 5",
      "msg": "with at least 5 lives left"
    }
  ]
}
