{
  "name": "idle_team_loses_4p",
  "description": "All four Builders, each placing its plan's first two towers and nothing else, lose before the twelfth wave. Generated by tools/gen_balance_scenarios.py: edit the generator, not this file.",
  "scene": "res://tests/sim/sim_harness.tscn",
  "seed": 1,
  "timeout_frames": 60,
  "watch": {
    "summary": "scene.summary()",
    "leaks": "scene.leak_table()"
  },
  "steps": [
    {
      "eval": "scene.start({\"builders\": [\"lamplighter\", \"lookout\", \"bellfounder\", \"beekeeper\"], \"events\": false, \"mode\": \"high_water\", \"plans\": {\"beekeeper\": [{\"alt\": [[12, 7]], \"build\": \"apiary\", \"cell\": [12, 9]}, {\"alt\": [[10, 9]], \"build\": \"clay_hive\", \"cell\": [11, 11]}], \"bellfounder\": [{\"alt\": [[14, 7]], \"build\": \"clapper_tower\", \"cell\": [13, 8]}, {\"alt\": [[5, 11]], \"build\": \"clapper_tower\", \"cell\": [5, 12]}], \"lamplighter\": [{\"alt\": [[7, 11]], \"build\": \"arrow\", \"cell\": [8, 11]}, {\"alt\": [[11, 12]], \"build\": \"arrow\", \"cell\": [11, 11]}], \"lookout\": [{\"alt\": [[12, 7]], \"build\": \"hawk_roost\", \"cell\": [12, 8]}, {\"alt\": [[5, 11]], \"build\": \"hawk_roost\", \"cell\": [6, 12]}]}, \"seats\": 4})"
    },
    {
      "eval": "scene.play_out([1, 2, 3, 4])",
      "as": "end"
    },
    {
      "eval": "scene.summary()",
      "as": "summary"
    },
    {
      "eval": "scene.leak_table()",
      "as": "leaks"
    },
    {
      "assert": "scene.client(1).towers.size() == 8",
      "msg": "each seat's two towers stood"
    },
    {
      "assert": "scene.client(1).hollows[0].phase == 3",
      "msg": "the Holdfast falls"
    },
    {
      "assert": "scene.client(1).hollows[0].wave < 12",
      "msg": "before wave 12"
    }
  ]
}
