{
  "name": "bot_wins_lookout_beekeeper",
  "description": "The Lookout and the Beekeeper, whose plans share six build cells in the middle of the hollow (the Beekeeper's opening Apiary stands on the Lookout's eighth step), win with at least half the lives. Generated by tools/gen_balance_scenarios.py: edit the generator, not this file.",
  "scene": "res://tests/sim/sim_harness.tscn",
  "seed": 1,
  "timeout_frames": 60,
  "watch": {
    "summary": "scene.summary()",
    "leaks": "scene.leak_table()"
  },
  "steps": [
    {
      "eval": "scene.start({\"builders\": [\"lookout\", \"beekeeper\"], \"caretakers\": [1, 2], \"events\": false, \"mode\": \"high_water\", \"seats\": 2})"
    },
    {
      "eval": "scene.play_out([])",
      "as": "end"
    },
    {
      "eval": "scene.summary()",
      "as": "summary"
    },
    {
      "eval": "scene.leak_table()",
      "as": "leaks"
    },
    {
      "assert": "scene.client(1).hollows[0].phase == 2 and scene.client(1).hollows[0].wave == 12",
      "msg": "the Holdfast stands after wave 12"
    },
    {
      "assert": "scene.client(1).teams[0].lives >= 10",
      "msg": "with at least 10 lives left"
    }
  ]
}
