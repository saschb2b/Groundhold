{
  "name": "bot_wins_lamplighter_bellfounder",
  "description": "The Lamplighter and the Bellfounder, whose plans share five build cells on the lower stretches (whoever builds a shared cell first keeps it; the other takes the step's alt cell or skips the step), win with at least half the lives. Generated by tools/gen_balance_scenarios.py: edit the generator, not this file.",
  "scene": "res://tests/sim/sim_harness.tscn",
  "seed": 1,
  "timeout_frames": 60,
  "watch": {
    "summary": "scene.summary()",
    "leaks": "scene.leak_table()"
  },
  "steps": [
    {
      "eval": "scene.start({\"builders\": [\"lamplighter\", \"bellfounder\"], \"caretakers\": [1, 2], \"events\": false, \"mode\": \"high_water\", \"seats\": 2})"
    },
    {
      "eval": "scene.play_out([])",
      "as": "end"
    },
    {
      "eval": "scene.summary()",
      "as": "summary"
    },
    {
      "eval": "scene.leak_table()",
      "as": "leaks"
    },
    {
      "assert": "scene.client(1).hollows[0].phase == 2 and scene.client(1).hollows[0].wave == 12",
      "msg": "the Holdfast stands after wave 12"
    },
    {
      "assert": "scene.client(1).teams[0].lives >= 10",
      "msg": "with at least 10 lives left"
    }
  ]
}
