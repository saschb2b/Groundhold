{
  "name": "idle_player_loses_hard",
  "description": "Hard (M8): a Lamplighter who places her plan's first two towers and nothing else loses before the twelfth wave. Generated by tools/gen_balance_scenarios.py: edit the generator, not this file.",
  "scene": "res://tests/sim/sim_harness.tscn",
  "seed": 1,
  "timeout_frames": 60,
  "watch": {
    "summary": "scene.summary()",
    "leaks": "scene.leak_table()"
  },
  "steps": [
    {
      "eval": "scene.start({\"builders\": [\"lamplighter\"], \"difficulty\": \"hard\", \"events\": false, \"mode\": \"high_water\", \"plans\": {\"lamplighter\": [{\"alt\": [[7, 11]], \"build\": \"arrow\", \"cell\": [8, 11]}, {\"alt\": [[11, 12]], \"build\": \"arrow\", \"cell\": [11, 11]}]}, \"seats\": 1})"
    },
    {
      "eval": "scene.play_out([1])",
      "as": "end"
    },
    {
      "eval": "scene.summary()",
      "as": "summary"
    },
    {
      "eval": "scene.leak_table()",
      "as": "leaks"
    },
    {
      "assert": "scene.client(1).towers.size() == 2",
      "msg": "each seat's two towers stood"
    },
    {
      "assert": "scene.client(1).hollows[0].phase == 3",
      "msg": "the Holdfast falls"
    },
    {
      "assert": "scene.client(1).hollows[0].wave < 12",
      "msg": "before wave 12"
    }
  ]
}
