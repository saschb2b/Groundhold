{
  "name": "high_water_length_2p",
  "description": "The two-player bot match (the Lamplighter and the Lookout, waiting out every window) lasts 11 to 15 minutes of match time. Generated by tools/gen_balance_scenarios.py: edit the generator, not this file.",
  "scene": "res://tests/sim/sim_harness.tscn",
  "seed": 1,
  "timeout_frames": 60,
  "watch": {
    "summary": "scene.summary()",
    "leaks": "scene.leak_table()"
  },
  "steps": [
    {
      "eval": "scene.start({\"builders\": [\"lamplighter\", \"lookout\"], \"caretakers\": [1, 2], \"events\": false, \"mode\": \"high_water\", \"seats\": 2})"
    },
    {
      "eval": "scene.play_out([])",
      "as": "end"
    },
    {
      "eval": "scene.summary()",
      "as": "summary"
    },
    {
      "eval": "scene.leak_table()",
      "as": "leaks"
    },
    {
      "assert": "scene.client(1).hollows[0].phase == 2 and scene.client(1).hollows[0].wave == 12",
      "msg": "the Holdfast stands after wave 12"
    },
    {
      "assert": "scene.client(1).tick >= 39600 and scene.client(1).tick <= 54000",
      "msg": "the match lasts 11 to 15 minutes"
    }
  ]
}
